# Source data: SELECT-only database account recommended. Never commit credentials.
PRICE_DATABASE_URL=
# Separate application database for alerts and user/server configuration.
APP_DATABASE_URL=
DISCORD_TOKEN=
DISCORD_GUILD_ID=
# Exact server role allowed to create auto trade posts (case-insensitive).
FUTBOT_TRADER_ROLE_NAME=Trader
GAME_YEAR=27
PLATFORM=ps5
ALERT_POLL_MS=30000
MAX_PRICE_AGE_MINUTES=15
FREE_ALERT_LIMIT=3

# Live dashboard: Discord OAuth2, same application as the bot.
PUBLIC_URL=https://YOUR-DASHBOARD-DOMAIN
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Generate with: openssl rand -hex 32. Keep stable across deploys.
SESSION_SECRET=
PORT=3000
# true runs the dashboard alongside the bot with npm start.
# For a separate dashboard service, use npm run start:web and leave false.
WEB_ENABLED=false

# Billing: use a restricted Stripe key with required Checkout/Portal permissions.
# Keep Stripe configuration on the website; bot reads entitlements from APP_DATABASE_URL.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_TOOLS=
STRIPE_PRICE_COMPLETE25=
STRIPE_PRICE_COMPLETE100=
STRIPE_PRICE_COMPLETE250=
# Optional separate portal configurations; disable plan switching in the default portal.
STRIPE_PORTAL_PERSONAL_CONFIG=
STRIPE_PORTAL_SERVER_CONFIG=
# Optional, explicit operator beta access (Complete 25) without taking payment.
# Set the SAME values on bot and website. Empty/expired values grant nothing.
FUTBOT_BETA_GUILD_IDS=
FUTBOT_BETA_UNTIL=

# Private SBC/EVO monitor. Set database on both dashboard and worker to share uploads.
# Uses the existing APP_DATABASE_URL; raw HARs are never stored.
CONTENT_WATCH_STORE=database
# Optional local-file mode only: set CONTENT_WATCH_STORE=file and use a volume.
CONTENT_WATCH_STATE_DIR=.content-watch
# Set on BOTH dashboard and worker: controls upload-page access and private DM recipient.
CONTENT_WATCH_USER_ID=

# Separate automatic EA browser worker only (Dockerfile.ea-browser).
# Share APP_DATABASE_URL, CONTENT_WATCH_USER_ID and SESSION_SECRET with dashboard.
# Attach a private persistent volume at /data to preserve the EA browser profile.
EA_BROWSER_PROFILE_DIR=/data/ea-browser
EA_BROWSER_INTERVAL_SECONDS=900
