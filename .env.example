# Source data: SELECT-only database account recommended. Never commit credentials.
PRICE_DATABASE_URL=
# Separate application database for alerts and user/server configuration.
APP_DATABASE_URL=
DISCORD_TOKEN=
DISCORD_GUILD_ID=
GAME_YEAR=27
PLATFORM=ps5
ALERT_POLL_MS=30000
MAX_PRICE_AGE_MINUTES=15
FREE_ALERT_LIMIT=3

# Live dashboard: Discord OAuth2, same application as the bot.
PUBLIC_URL=https://YOUR-DASHBOARD-DOMAIN
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Generate with: openssl rand -hex 32. Keep stable across deploys.
SESSION_SECRET=
PORT=3000
# true runs the dashboard alongside the bot with npm start.
# For a separate dashboard service, use npm run start:web and leave false.
WEB_ENABLED=false
